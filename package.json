{
  "name": "pi-livecraft",
  "private": true,
  "version": "1.2.0",
  "keywords": [
    "pi-coding-agent",
    "pi",
    "ai-agent",
    "developer-tools",
    "react",
    "vite",
    "typescript",
    "live-reload",
    "web-workbench",
    "session-management",
    "terminal",
    "local-first"
  ],
  "bin": {
    "pi-livecraft": "./bin/pi-livecraft.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --kill-timeout 3000 --names manager,backend,plugin npm:dev:manager npm:dev:backend npm:dev:plugin",
    "start": "npm run build && concurrently --kill-others --kill-timeout 3000 --names manager,backend npm:start:manager npm:start:backend",
    "dev:plugin": "vite build --watch",
    "dev:backend": "node --watch server/backend.ts",
    "dev:manager": "node server/manager-supervisor.ts",
    "start:backend": "node server/backend.ts",
    "start:manager": "node server/manager-supervisor.ts",
    "build": "npm run typecheck && vite build",
    "verify:dist": "git diff --exit-code dashboard/dist/",
    "typecheck": "tsc -b",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint .",
    "test": "node --test && PYTHONPATH=. python3 test/hermes_plugin_runtime.test.py && PYTHONPATH=. python3 test/hermes_plugin_api.test.py",
    "eval:documentation-routing": "node --test evals/documentation-routing.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.3",
    "diff": "^8.0.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "dprint": "^0.55.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,css,html}": "dprint fmt",
    "!(*-lock).json": "dprint fmt"
  },
  "allowScripts": {
    "dprint@0.55.2": true
  }
}
